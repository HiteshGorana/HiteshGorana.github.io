---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import resume from '../data/resume.json';

const { basics, education, work, skills, interests, awards, projects } = resume;
const recentPosts = (await getCollection('blog'))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<!DOCTYPE html>
<html lang="en" data-theme="paper">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{basics.name} - {basics.label}</title>
    <meta name="description" content={`${basics.label} based in ${basics.location.city}, ${basics.location.country}`}>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <a class="skip-link" href="#about">Skip to content</a>
    <header class="site-header">
        <div class="container nav-container">
            <a href="/" class="logo">{basics.name}</a>
            <div class="nav-shell">
                <nav class="nav-links nav-links-main" aria-label="Primary">
                    <a href="#about">About</a>
                    <a href="#experience">Experience</a>
                    <a href="#projects">Projects</a>
                    <a href="#skills">Skills</a>
                    <a href="#interests">Interests</a>
                    <a href="#contact">Contact</a>
                </nav>
                <div class="nav-actions">
                    <a href="/blog" class="nav-cta">Blog</a>
                    <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
                        <i class="fas fa-circle-half-stroke"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <main>
        <section id="about" class="hero section-shell">
            <div class="container hero-grid">
                <div class="hero-copy">
                    <p class="eyebrow">Portfolio dossier</p>
                    <h1>{basics.name}</h1>
                    <p class="lede">
                        {basics.label} with <strong>{basics.totalExperience}</strong> of experience based in {basics.location.city}, {basics.location.country}.
                        I build systems across machine learning, AI, backend engineering, and product-facing software.
                    </p>
                    <p class="intro-note">Focused on high-signal product work: search, automation, performance, and applied AI.</p>

                    <div class="hero-meta">
                        <div class="meta-card">
                            <span class="meta-label">Focus</span>
                            <span class="meta-value">AI systems, search, full-stack delivery</span>
                        </div>
                        <div class="meta-card">
                            <span class="meta-label">Contact</span>
                            <span class="meta-value"><a href={`mailto:${basics.email}`}>{basics.email}</a></span>
                        </div>
                    </div>

                    <div class="social-links">
                        <a href={`mailto:${basics.email}`} class="button-link">Email</a>
                        {basics.profiles.map(profile => (
                            <a href={profile.url} target="_blank" rel="noreferrer" class="button-link">
                                {profile.network}
                            </a>
                        ))}
                    </div>
                </div>

                <aside class="hero-panel">
                    <div class="panel-header">
                        <span>Current profile</span>
                        <span class="panel-chip">Available for impact</span>
                    </div>
                    <div class="panel-body">
                        <div class="profile-line">
                            <span class="profile-label">Role</span>
                            <span class="profile-value">{basics.label}</span>
                        </div>
                        <div class="profile-line">
                            <span class="profile-label">Location</span>
                            <span class="profile-value">{basics.location.city}, {basics.location.country}</span>
                        </div>
                        <div class="profile-line">
                            <span class="profile-label">Experience</span>
                            <span class="profile-value">{basics.totalExperience}</span>
                        </div>
                        <div class="profile-line">
                            <span class="profile-label">Strengths</span>
                            <span class="profile-value">Search, infra, product delivery, AI</span>
                        </div>
                    </div>
                    <div class="panel-footer">
                        <div class="metric">
                            <span class="metric-value">{basics.totalExperience}</span>
                            <span class="metric-label">Experience</span>
                        </div>
                        <div class="metric">
                            <span class="metric-value">{work.length}</span>
                            <span class="metric-label">Roles</span>
                        </div>
                        <div class="metric">
                            <span class="metric-value">{projects.length}</span>
                            <span class="metric-label">Projects</span>
                        </div>
                    </div>
                    <p class="panel-caption">Use the sections above to jump directly to work history, project evidence, and technical depth.</p>
                </aside>
            </div>
        </section>

        <section id="experience" class="section-shell">
            <div class="container">
                <div class="section-head">
                    <p class="eyebrow">01 · Experience</p>
                    <h2>Career narrative</h2>
                    <p>Roles are framed around outcome, scale, and technical ownership.</p>
                </div>
                <div class="timeline">
                    {work.map(job => (
                        <article class="timeline-item">
                            <div class="job-header">
                                <div>
                                    <h3 class="job-title">{job.position}</h3>
                                    <p class="job-company">{job.company}</p>
                                </div>
                                <p class="job-meta">{job.startDate} — {job.endDate} · {job.location}</p>
                            </div>
                            <p class="job-summary-lead">A concise summary of the impact delivered in this role.</p>
                            <ul class="bullet-list">
                                {job.summary.split('\n').map(line => line.trim()).filter(Boolean).map(line => (
                                    <li set:html={line.replace(/^- /, '').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></li>
                                ))}
                            </ul>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section id="projects" class="section-shell">
            <div class="container">
                <div class="section-head">
                    <p class="eyebrow">02 · Projects</p>
                    <h2>Selected work</h2>
                    <p>Projects are presented as editorial cards with the stack visible but secondary.</p>
                </div>
                <div class="project-grid">
                    {projects.map(project => (
                        <article class="project-card">
                            <div class="card-topline">
                                <p class="card-kicker">Featured project</p>
                                <a href={project.url} target="_blank" rel="noreferrer" class="card-link">Open</a>
                            </div>
                            <h3>{project.name}</h3>
                            <p class="project-summary">{project.summary}</p>
                            <p class="project-tech">{project.tech}</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section id="skills" class="section-shell">
            <div class="container">
                <div class="section-head">
                    <p class="eyebrow">03 · Skills</p>
                    <h2>Technical matrix</h2>
                    <p>Capabilities are grouped into readable categories rather than badge walls.</p>
                </div>
                <div class="skills-grid">
                    {skills.map(category => (
                        <article class="skill-category">
                            <h3>{category.name}</h3>
                            <div class="skill-tags">
                                {category.keywords.map(keyword => (
                                    <span class="skill-tag">{keyword}</span>
                                ))}
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section id="interests" class="section-shell">
            <div class="container">
                <div class="section-head">
                    <p class="eyebrow">04 · Interests</p>
                    <h2>Research themes</h2>
                    <p>These cards show technical taste and areas of ongoing curiosity.</p>
                </div>
                <div class="interests-grid">
                    {interests.map(interest => (
                        <article class="interest-card">
                            <h3>{interest.name}</h3>
                            <div class="skill-tags">
                                {interest.keywords.map(keyword => (
                                    <span class="interest-tag">{keyword}</span>
                                ))}
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section id="awards" class="section-shell">
            <div class="container">
                <div class="section-head">
                    <p class="eyebrow">05 · Education and awards</p>
                    <h2>Supporting evidence</h2>
                    <p>Education and awards stay lighter than the main career story.</p>
                </div>
                <div class="split-grid">
                    <div class="detail-column">
                        <h3>Education</h3>
                        {education.map(edu => (
                            <article class="detail-card">
                                <h4>{edu.institution}</h4>
                                <p class="detail-meta">{edu.area} · {edu.studyType}</p>
                                <p class="detail-meta">{edu.startDate} — {edu.endDate} · {edu.location}</p>
                                <ul class="bullet-list">
                                    {edu.achievements.map(achievement => (
                                        <li set:html={achievement.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></li>
                                    ))}
                                </ul>
                            </article>
                        ))}
                    </div>
                    <div class="detail-column">
                        <h3>Awards</h3>
                        {awards.map(award => (
                            <article class="detail-card">
                                <h4>{award.title}</h4>
                                <p>{award.summary}</p>
                            </article>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <section id="blog" class="section-shell">
            <div class="container">
                <div class="section-head">
                    <p class="eyebrow">06 · Blog</p>
                    <h2>Writing and notes</h2>
                    <p>Recent posts appear automatically from Markdown files in `src/content/blog/`.</p>
                </div>
                <div class="blog-list">
                    {recentPosts.length > 0 ? recentPosts.map(post => (
                        <article class="blog-card">
                            <p class="card-kicker">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
                            <h3><a href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
                            <p>{post.data.description}</p>
                        </article>
                    )) : (
                        <article class="blog-card">
                            <h3>No posts yet</h3>
                            <p>Add a Markdown file to `src/content/blog/` to publish the first entry.</p>
                        </article>
                    )}
                </div>
                <div class="blog-footer-link">
                    <a href="/blog" class="button-link">View all posts</a>
                </div>
            </div>
        </section>
    </main>

    <footer id="contact" class="site-footer section-shell">
        <div class="container footer-inner">
            <div>
                <p class="eyebrow">Contact</p>
                <h2>Let’s build something useful.</h2>
            </div>
            <div class="footer-links">
                <a href={`mailto:${basics.email}`}>{basics.email}</a>
                <a href={`tel:${basics.phone}`}>{basics.phone}</a>
            </div>
            <p class="copyright">&copy; {new Date().getFullYear()} {basics.name}.</p>
        </div>
    </footer>

    <script>
        import "../scripts/main.js";
    </script>
</body>
</html>
